#! /usr/local/bin/PikaCmd

/*
	Generates tests/fuzz/fuzz.dict from the readable token list below. Run from the repository root:

		externals/PikaCmd/PikaCmd.exe tools/makeFuzzDict.pika

	The harness reads its input as UTF-16LE (LLVMFuzzerTestOneInput casts to Char, which is UInt16, and takes Size / 2
	code units), so every ASCII character in a dictionary entry must be followed by \x00. That is what makes the
	generated file unreadable and this list necessary. In the list: a line starting with # is a comment and is copied
	through, a line starting with a double quote is a finished dict entry and is copied through, and anything else is a
	plain token that gets encoded.
*/

include('stdlib.pika');

vargs(@me, , @outPath);
defaults(@outPath, 'tests/fuzz/fuzz.dict');

tokens = '
# ES3 7.5.2 keywords
break
case
catch
continue
default
delete
do
else
finally
for
function
if
in
instanceof
new
return
switch
this
throw
try
typeof
var
void
while
with
# literals and core globals, reachable without the standard library
null
true
false
undefined
NaN
Infinity
eval
arguments
# standard library names, which only the LIBFUZZ_STDLIB build can reach
Object
Array
String
Number
Boolean
Math
Date
RegExp
Error
JSON
parseInt
parseFloat
isNaN
prototype
constructor
length
toString
valueOf
call
apply
hasOwnProperty
push
join
charAt
charCodeAt
fromCharCode
indexOf
replace
split
slice
concat
sort
toFixed
toPrecision
toExponential
getTime
parse
stringify
# multi-character operators
===
!==
==
!=
<=
>=
&&
||
++
--
+=
-=
*=
/=
%=
&=
|=
^=
<<
>>
>>>
<<=
>>=
>>>=
# number forms, including the denormals and boundaries that conversion gets wrong
0x
0X
1e
1E
e+
e-
.5
0.1
1e308
1e-308
1e-310
5e-324
0xFFFFFFFF
2147483648
4294967296
9007199254740993
1e21
# string escapes
\u
\x
\0
\n
\r
\t
\\
\u0000
\uD800
# \uFFFF, written verbatim because a literal \uXXXX in this file can be folded into the character itself
"\\\x00u\x00F\x00F\x00F\x00F\x00"
# comments and the regex literals the lexer must still scan
//
/*
*/
/a/g
/(?:)/
# the two quote characters, written out because this list is itself a quoted string
"\x27\x00"
"\x22\x00"
# common shapes, which seed structure rather than single tokens
function(){}
(function(){})()
var a=
for(;;)
while(1)
do{}while(0)
{}
[]
();
use strict
a:
try{}catch(e){}
with(a)
# raw UTF-16LE code units, written as their own bytes rather than as ASCII plus \x00
# U+2028 LINE SEPARATOR, an ES3 7.3 line terminator
"\x28\x20"
# U+2029 PARAGRAPH SEPARATOR
"\x29\x20"
# U+00A0 NO-BREAK SPACE, ES3 7.2 whitespace
"\xa0\x00"
# U+FEFF BYTE ORDER MARK, also 7.2 whitespace
"\xff\xfe"
# U+3000 IDEOGRAPHIC SPACE, an Other-category-Zs space we reject
"\x00\x30"
# unpaired high surrogate
"\x00\xd8"
# unpaired low surrogate
"\x00\xdc"
# U+0000, legal inside a string literal
"\x00\x00"
';

encodeToken = function {
	source = $0;
	encoded = '';
	for (i = 0; i < length(source); ++i) {
		c = source{i:1};
		if (c === '"' || c === '\') {
			encoded #= '\';
		};
		encoded #= c # '\x00';
	};
	encoded;
};

output = '# libFuzzer dictionary for NuXJS, generated by tools/makeFuzzDict.pika. Do not edit by hand.' # LF
		# '# Every ASCII character is followed by \x00 because the harness reads UTF-16LE; see the generator.' # LF;
entryCount = 0;
tokenize(tokens, >{
	line = $0;
	if (line !== '') {
		if (line{:1} === '#') {
			output #= LF # line # LF;
		} else if (line{:1} === '"') {
			output #= line # LF;
			++entryCount;
		} else {
			output #= '"' # encodeToken(line) # '"' # LF;
			++entryCount;
		};
	};
});

save(outPath, output);
print('Wrote ' # outPath # ' with ' # entryCount # ' entries.');
